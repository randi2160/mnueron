{
  "manifest_version": 3,
  "name": "MNUERON — AI memory autosync",
  "short_name": "MNUERON",
  "version": "0.1.0",
  "description": "Automatically syncs your conversations on Claude.ai and ChatGPT.com to your MNUERON memory.",

  "browser_specific_settings": {
    "gecko": {
      "id": "mnueron@mnueron.dev",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/observer.js", "lib/content_extractor.js", "lib/self_healing.js", "content_scripts/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["lib/observer.js", "lib/content_extractor.js", "lib/self_healing.js", "content_scripts/chatgpt.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MNUERON",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
